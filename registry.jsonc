{
  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "isomoes",
  "version": "0.1.0",
  "author": "isomoes",
  "components": [
    {
      "name": "commit-message",
      "type": "command",
      "description": "Generate an emoji Conventional Commit message from current changes.",
      "files": [
        "commands/commit-message.md"
      ]
    },
    {
      "name": "mcp-servers",
      "type": "bundle",
      "description": "Register Context7 and GitHub MCP servers.",
      "files": [],
      "opencode": {
        "mcp": {
          "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
              "CONTEXT7_API_KEY": "{env:C7_KEY}"
            },
            "oauth": false,
            "enabled": true
          },
          "github": {
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "oauth": false,
            "headers": {
              "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
            },
            "enabled": true
          }
        }
      }
    },
    {
      "name": "opencode",
      "type": "bundle",
      "description": "Reusable OpenCode V1 command and MCP configuration.",
      "files": [],
      "dependencies": [
        "commit-message",
        "mcp-servers"
      ]
    }
  ]
}
